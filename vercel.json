{
  "functions": {
    "api/centro.js": {
      "includeFiles": "{api/_docs/**,api/_lib/**}"
    },
    "api/ver.js": {
      "includeFiles": "{api/_docs/**,api/_lib/**}"
    },
    "api/leer-negocio.js": {
      "maxDuration": 60
    },
    "api/demo-eventos.js": {
      "includeFiles": "{api/_docs/**}"
    },
    "api/oficina.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "https://jason.moondigitalia.workers.dev/api/privacidad"
    },
    {
      "source": "/mijason",
      "destination": "https://jason.moondigitalia.workers.dev/api/mijason"
    },
    {
      "source": "/mijason/:ruta*",
      "destination": "https://jason.moondigitalia.workers.dev/api/mijason/:ruta*"
    },
    {
      "source": "/excel",
      "destination": "https://jason.moondigitalia.workers.dev/api/excel"
    },
    {
      "source": "/comprobante",
      "destination": "https://jason.moondigitalia.workers.dev/api/comprobante"
    },
    {
      "source": "/cotizacion/:ruta*",
      "destination": "https://jason.moondigitalia.workers.dev/api/cotizacion/:ruta*"
    },
    {
      "source": "/tablero",
      "destination": "/centro/index.html"
    },
    {
      "source": "/ver/:codigo",
      "destination": "/api/ver?t=:codigo"
    },
    {
      "source": "/prueba/:codigo",
      "destination": "/prueba/index.html"
    },
    {
      "source": "/calculadora/:codigo",
      "destination": "/calculadora/index.html"
    },
    {
      "source": "/presentacion/:codigo",
      "destination": "/presentacion/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/centro",
      "destination": "/tablero",
      "permanent": false
    },
    {
      "source": "/centro/",
      "destination": "/tablero",
      "permanent": false
    },
    {
      "source": "/centro/index.html",
      "destination": "/tablero",
      "permanent": false
    },
    {
      "source": "/oficina",
      "destination": "/tablero",
      "permanent": false
    },
    {
      "source": "/oficina/",
      "destination": "/tablero",
      "permanent": false
    },
    {
      "source": "/oficina/index.html",
      "destination": "/tablero",
      "permanent": false
    }
  ]
}
